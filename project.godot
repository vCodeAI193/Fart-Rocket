; Engine configuration file.
; Fart Rocket – 2D Physik-Spiel für Android Tablets (Godot 4.x)
; ===============================================================
; Die meisten Werte werden im Editor unter "Projekteinstellungen"
; gepflegt. Hier sind die wichtigsten Einstellungen für Touch,
; Landscape-Orientierung und die Basisauflösung 1920x1200 gesetzt.

config_version=5

[application]

config/name="Fart Rocket"
config/description="Ein physikbasiertes 2D-Spiel: Steuere ein Strichmännchen mit Furz-Antrieb durch Hindernis-Level."
run/main_scene="res://scenes/SplashScreen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

; Globaler Spielzustand: Punkte, aktuelles Level, Sterne usw.
GameManager="*res://scripts/GameManager.gd"
; Kosmetik-Katalog, Freischaltung & Ausrüstung (Mix&Match). Ausgelagert aus
; GameManager.gd ("God Object"-Refactoring, siehe README.md); referenziert
; GameManager.persistent_coins für Käufe.
CosmeticsManager="*res://scripts/CosmeticsManager.gd"
; Gehärtetes, mehrfach-profilfähiges Speichersystem. Ausgelagert aus
; GameManager.gd; nach GameManager/CosmeticsManager geladen, da es beide
; beim Speichern/Laden per Cross-Reference liest/schreibt.
SaveManager="*res://scripts/SaveManager.gd"
; FR-241/242/246/249/251/253-256: Prozedurale Musik & Audio-Bus-Verwaltung
; (nach GameManager/SaveManager geladen, da es deren Signale abonniert
; bzw. beim Speichern der Musik-Lautstärke SaveManager aufruft).
SoundManager="*res://scripts/SoundManager.gd"
; FR-421-440: Barrierefreiheits-/Einstellungs-Felder. Ausgelagert aus
; GameManager.gd (zweite Runde des "God Object"-Refactorings).
AccessibilityManager="*res://scripts/AccessibilityManager.gd"
; FR-341-360: Spielmodi (GameMode-Enum, Bestwerte, Zeitrennen, Geister-
; Pfade, Tages-Seed). Ebenfalls aus GameManager.gd ausgelagert; ruft
; AchievementManager.MODIFIERS auf (Konstante, ladereihenfolge-unabhängig).
GameModeManager="*res://scripts/GameModeManager.gd"
; FR-321: Lokales Achievement-/Herausforderungs-Framework (nach GameManager
; geladen, da es dessen Statistik-Signale abonniert).
AchievementManager="*res://scripts/AchievementManager.gd"
; FR-441: Lokalisierungs-System (nach AccessibilityManager geladen, da es
; AccessibilityManager.language beim Start liest).
LocalizationManager="*res://scripts/LocalizationManager.gd"

[display]

; Basisauflösung für 16:10 Tablets (1920x1200)
window/size/viewport_width=1920
window/size/viewport_height=1200
; Nur Querformat (Landscape) erlauben (0 = Landscape)
window/handheld/orientation=0
; Skalierung der UI/2D-Elemente -> canvas_items für gleichmäßige Skalierung
window/stretch/mode="canvas_items"
; "expand" füllt verschiedene Seitenverhältnisse (16:10 und 4:3) aus
window/stretch/aspect="expand"
; FR-478: VSync explizit aktiv statt Engine-Default — vermeidet Tearing
; und unregelmäßiges Frame-Pacing auf mobilen Geräten (kostet auf den
; meisten Android-GPUs kaum Overhead, im Gegensatz zu Desktop-Perf-Fällen).
window/vsync/vsync_mode=1

[input_devices]

; Touch-Eingabe aktivieren und Maus für Desktop-Tests emulieren
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

; FR-471: Physik-Schritt explizit statt Engine-Default — 60 Hz passt zum
; Ziel-Framerate-Bereich mobiler Android-Geräte (API 21+) und macht das
; Zeitverhalten (Kollisionen, RigidBody-Impulse) reproduzierbar statt vom
; jeweiligen Gerät abhängig.
common/physics_ticks_per_second=60

; 2D-Schwerkraft (wird zusätzlich pro Spieler über gravity_scale skaliert)
2d/default_gravity=980.0

[rendering]

; GL Compatibility Renderer -> beste Kompatibilität für Android API 21+
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
